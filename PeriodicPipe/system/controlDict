#include "$FOAM_CASE/constant/variables"

application     denseParticleFoam;

startFrom       latestTime;

stopAt          endTime;

endTime         5;//$varEndTime;

deltaT          $varDeltaT;

adjustTimeStep  true;

maxCo           1;

writeControl    adjustableRunTime; //timeStep;

writeInterval   0.002;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

