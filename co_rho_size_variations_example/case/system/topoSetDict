    type        cellSet;
    action      new;

    // Mandatory entries
    source      faceToCell;
    option      owner;

    // Conditional mandatory entries
    // Select either of the below

    // Option-2 
    set     cyc_half1FaceSet;
}

{
    // Mandatory (inherited) entries
    name        cyc_half1FaceZone;
    type        faceZoneSet;
    action      new;

    // Mandatory entries
    source      setsToFaceZone;
    faceSet     cyc_half1FaceSet;
    cellSet     cyc_half1CellSet;

    // Optional entries
    flip        false;
}

